# Priority order: Gemini is tried first. If it's missing, rate-limited, or
# errors out, the app automatically falls back to OpenRouter's free models.
# You can set either one, or both for maximum reliability.

# Get a free key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key

# Get a free key at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
